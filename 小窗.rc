LANGUAGE 4, 2

/////////////////////////////////////////////////////////////////////////////
//
// 图标
//

// ID 值最低的图标放在最前面，以确保应用程序图标
// 在所有系统中保持一致。

IDI_MY                  ICON         "assets\\XiaoChuang.ico"
IDI_SMALL               ICON         "assets\\XiaoChuang.ico"

/////////////////////////////////////////////////////////////////////////////
//
// 版本
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,0,0
 PRODUCTVERSION 0,2,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "Cliffamr\0"
            VALUE "FileDescription", "Veil Browser - Windows overlay browser\0"
            VALUE "FileVersion", "0.2.0.0\0"
            VALUE "InternalName", "VeilBrowser\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 AzurPlain contributors and Cliffamr\0"
            VALUE "OriginalFilename", "VeilBrowser.exe\0"
            VALUE "ProductName", "Veil Browser\0"
            VALUE "ProductVersion", "0.2.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END

/////////////////////////////////////////////////////////////////////////////
//
// 菜单
//

IDC_MY MENU
BEGIN
    POPUP "File / Berkas (&F)"
    BEGIN
        MENUITEM "Exit / Keluar (&X)",                IDM_EXIT
    END
    POPUP "Help / Bantuan (&H)"
    BEGIN
        MENUITEM "About / Tentang (&A) ...",           IDM_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// 快捷键
//

IDC_MY ACCELERATORS
BEGIN
    "?",            IDM_ABOUT,              ASCII,  ALT
    "/",            IDM_ABOUT,              ASCII,  ALT
END


/////////////////////////////////////////////////////////////////////////////
//
// 对话框
//

IDD_ABOUTBOX DIALOGEX 0, 0, 170, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About / Tentang Veil Browser"
FONT 9, "MS Shell Dlg"
BEGIN
    ICON            IDI_MY,IDC_STATIC,14,14,21,20
    LTEXT           "Veil Browser, version 0.2.0",IDC_STATIC,42,14,114,8,SS_NOPREFIX
    LTEXT           "Copyright (c) 2026",IDC_STATIC,42,26,114,8
    DEFPUSHBUTTON   "OK",IDOK,113,41,50,14,WS_GROUP
END

/////////////////////////////////////////////////////////////////////////////
//
// DESIGNINFO
//

#ifdef APSTUDIO_INVOKED
GUIDELINES DESIGNINFO
BEGIN
    IDD_ABOUTBOX, DIALOG
    BEGIN
        LEFTMARGIN, 7
        RIGHTMARGIN, 163
        TOPMARGIN, 7
        BOTTOMMARGIN, 55
    END
END
#endif    // APSTUDIO_INVOKED

